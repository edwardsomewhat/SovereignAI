[Unit]
Description=ComfyUI Image Generation Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%u
WorkingDirectory=WORKSPACE_DIR
ExecStart=WORKSPACE_DIR/.venv/bin/python WORKSPACE_DIR/main.py --listen 0.0.0.0 --port 8188
Restart=on-failure
RestartSec=10
Environment=PATH=WORKSPACE_DIR/.venv/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
